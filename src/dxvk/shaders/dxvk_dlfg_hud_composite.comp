#version 450

// [nfs2se 0021] HUD-less frame generation: DLFG wrote a generated frame from HUD-less inputs into o_generated; every pixel the UI
// raster changed in the rendered frame (rendered != hudless) is copied from the rendered frame, so the UI is shown as drawn,
// never warped by the scene's motion vectors. Both inputs went through the same present blit, so an untouched pixel is bit-equal.

#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform texture2D s_rendered;
layout(set = 0, binding = 1) uniform texture2D s_hudless;
layout(set = 0, binding = 2) writeonly uniform image2D o_generated;

layout(push_constant) uniform push_t {
  uvec2 extent;
  ivec2 rectMin;   // [nfs2se 0031] the screen's pixel rectangle, half open (rectMax <= rectMin = none); two ivec2, not an ivec4: no std430 padding
  ivec2 rectMax;
};

void main() {
  const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
  if (any(greaterThanEqual(uvec2(p), extent))) {
    return;
  }

  const vec4 rendered = texelFetch(s_rendered, p, 0);
  const vec3 hudless = texelFetch(s_hudless, p, 0).rgb;

  // [nfs2se 0031] a pixel inside `rect` (the screen of a raytraced render target) is the RENDERED frame's picture whatever the interpolation made of it:
  // the picture is another camera's ray traced image, which the scene's motion vectors and depth do not describe, so interpolating it only cross-fades two pictures
  const bool inRect = all(greaterThanEqual(p, rectMin)) && all(lessThan(p, rectMax));

  // half an 8-bit step: any UI write to the pixel, however faint, takes it
  if (inRect || any(greaterThan(abs(rendered.rgb - hudless), vec3(0.5 / 255.0)))) {
    imageStore(o_generated, p, rendered);
  }
}
